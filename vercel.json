{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/" }]
}
{
  "rewrites": [
    {
      "source": "/real-estate",
      "destination": "https://prop-flow-three.vercel.app/"
    },
    {
      "source": "/real-estate/:path*",
      "destination": "https://prop-flow-three.vercel.app/:path*"
    }
  ]
}
